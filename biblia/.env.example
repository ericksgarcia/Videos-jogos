# Copie para .env (ignorado pelo git) e preencha. Nunca versione chaves.
GOOGLE_TTS_API_KEY=        # Google Cloud Text-to-Speech (habilite a API "Cloud Text-to-Speech")
REPLICATE_API_TOKEN=       # replicate.com/account/api-tokens
PEXELS_API_KEY=            # pexels.com/api (grátis)
# GEMINI_API_KEY=          # roteiro (Gemini). Nas sessões na nuvem a credencial é injetada pelo ambiente.
# GOOGLE_TTS_VOICE=pt-BR-Neural2-B   # alternativas graves: pt-BR-Wavenet-B, pt-BR-Neural2-C (feminina)
# FLUX_MODEL=black-forest-labs/flux-schnell   # ou black-forest-labs/flux-dev (mais qualidade, mais lento)
# DEPTH_MODEL=cjwbw/depth-anything            # ou chenxwh/depth-anything-v2
# REMOTION_GL=angle         # com GPU; em servidor sem GPU use swangle
# CHROME_PATH=              # caminho de um Chrome/headless_shell, se o Remotion não achar o dele
# MAX_MB=28                 # tamanho máximo do MP4 final
