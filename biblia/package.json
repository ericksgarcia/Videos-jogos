{
  "name": "biblia-video",
  "private": true,
  "type": "module",
  "description": "Esteira de vídeos bíblicos verticais: catálogo, roteiro com CTA dinâmico, Google TTS, sonoplastia, Replicate/Pexels e render no Remotion",
  "scripts": {
    "catalogo": "tsx scripts/build-catalog.ts",
    "video": "tsx src/pipeline/run.ts",
    "studio": "tsx scripts/make-overlays.ts && remotion studio src/remotion/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "novo": "tsx scripts/novo-video.ts"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@remotion/bundler": "^4.0.300",
    "@remotion/cli": "^4.0.300",
    "@remotion/renderer": "^4.0.300",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.300",
    "undici": "^7.30.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3"
  }
}